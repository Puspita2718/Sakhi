# SAKHI Environment Variables Configuration
# Copy this file to .env and fill in your Supabase project details.

# Your Supabase Project API URL (found under Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project public anon key (found under Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Set to true to bypass Supabase and run the app in Sandbox Mock Mode (accepts any credentials for login/signup)
VITE_USE_MOCK=false
